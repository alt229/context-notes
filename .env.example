# Copy to .env and fill in. .env is ignored by git; never commit it.

# The name people will type. Its zone must be on Cloudflare (for the certificate); the name itself can point at
# a private address, e.g. a record on your home router.
DOMAIN=films.example.com

# Ports on the Docker host. 80 only redirects to HTTPS. If HTTPS_PORT isn't 443, also set PUBLIC_URL to the address
# people will type, e.g. https://films.example.com:8443
HTTP_PORT=80
HTTPS_PORT=443
#PUBLIC_URL=https://films.example.com:8443

# Let's Encrypt sends renewal notices here.
ACME_EMAIL=you@example.com

# A Cloudflare API token with  Zone / DNS / Edit  on the zone above (and Zone / Zone / Read). Nothing else.
CLOUDFLARE_API_TOKEN=

# The folder with your films. Notes, .ass files and the "<video> analysis" folders are written beside the videos,
# so it must be writable.
MEDIA_DIR=/path/to/your/films

# The user and group that own the films, so the container can write beside them (id -u / id -g).
PUID=1000
PGID=1000

# Claude Code's sign-in. Leave empty to keep it in a Docker volume and sign in once with
#   docker compose exec -it app claude auth login
# or give the path of a ~/.claude folder that is already signed in, e.g. /home/you/.claude
CLAUDE_DIR=

# 1 to include faster-whisper (speech recognition for --align and subtitles from the soundtrack). Large download.
WITH_WHISPER=0
